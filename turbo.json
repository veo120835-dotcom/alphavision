{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build", "validate"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "validate": {
      "dependsOn": [],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check-boundaries": {
      "dependsOn": [],
      "outputs": []
    },
    "check-tool-invocations": {
      "dependsOn": [],
      "outputs": []
    },
    "check-service-duplication": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
